{
  "name": "trailerdesk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --port 5174 --strictPort",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "jscpd": "jscpd app server",
    "depcruise": "depcruise --config .dependency-cruiser.cjs app server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm jscpd && pnpm depcruise && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare": "lefthook install",
    "secrets:check": "tsx scripts/secrets.ts",
    "secrets:staged": "tsx scripts/secrets.ts staged",
    "secrets:history": "tsx scripts/secrets.ts history"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/provider": "4.0.34",
    "@better-auth/drizzle-adapter": "1.7.13",
    "@fontsource-variable/geist": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@t3-oss/env-core": "0.13.11",
    "agents": "0.30.1",
    "ai": "7.0.153",
    "better-auth": "1.7.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "isbot": "5.1.36",
    "lucide-react": "1.61.0",
    "mailtrap": "5.0.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "remark-gfm": "4.0.1",
    "resend": "6.34.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@msw/cloudflare": "0.2.0",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
