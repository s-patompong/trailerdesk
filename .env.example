# Local infrastructure and Node-based tools. Copy to .env.
# Worker runtime values and secrets stay in .dev.vars locally.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=trailerdesk
POSTGRES_PASSWORD=trailerdesk_local
POSTGRES_DB=trailerdesk
POSTGRES_TEST_DB=trailerdesk_test
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}

# Wrangler's documented local Hyperdrive overrides. The cached binding still
# connects directly in local mode; production caching belongs to Cloudflare.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=${DATABASE_URL}
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_CACHED=${DATABASE_URL}

MAILPIT_HOST=127.0.0.1
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025
LOCAL_APP_URL=http://127.0.0.1:5174
