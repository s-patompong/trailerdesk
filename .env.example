# Local infrastructure, tools and Worker runtime. Copy to .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=trailerdesk
POSTGRES_PASSWORD=trailerdesk_local
POSTGRES_DB=trailerdesk
POSTGRES_TEST_DB=trailerdesk_test
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_TEST_DB}

# Wrangler's documented local Hyperdrive overrides. The cached binding still
# connects directly in local mode; production caching belongs to Cloudflare.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=${DATABASE_URL}
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB_CACHED=${DATABASE_URL}

MAILPIT_HOST=127.0.0.1
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025

# Worker runtime configuration. Production uses Cloudflare variables and secrets.
APP_ENV=development
APP_URL=http://localhost:5174
BETTER_AUTH_SECRET=local-only-change-this-before-deploy-32chars
EMAIL_FROM=mail@trailerdesk.test
EMAIL_DRIVER=mailpit
MAILPIT_URL=http://127.0.0.1:18025
LLM_PROVIDER=workers-ai
DEMO_FAST_TIME=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ANTHROPIC_API_KEY, RESEND_API_KEY
# EMAIL_DRIVER=mailtrap
# MAILTRAP_API_TOKEN=your-sandbox-token
# MAILTRAP_INBOX_ID=your-inbox-id
# ALLOW_LIVE_EMAIL=false
# WORKERS_AI_MODEL=@cf/openai/gpt-oss-120b
# ANTHROPIC_MODEL=claude-sonnet-5-5
# HOLD_HOURS=48
# LEAD_STALE_DAYS=14
# AGING_NOTICE_DAYS=60
# AGING_WARNING_DAYS=90
# AGING_CRITICAL_DAYS=120
# NIGHTLY_JOB_HOUR=2
# MORNING_SUMMARY_HOUR=8
# CHECK_IN_DAYS=3
# REVIEW_AFTER_CHECK_IN_DAYS=30
# DEMO_HOLD_SECONDS=30
# DEMO_CHECK_IN_SECONDS=3
# DEMO_REVIEW_SECONDS=9
